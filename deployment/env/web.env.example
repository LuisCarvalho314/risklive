# Scheduler and ops logs use Europe/London; cron times follow DST.
TZ=Europe/London
NODE_ENV=production
PORT=3000
HOSTNAME=0.0.0.0

# Optional: override dashboard payload source.
# DASHBOARD_JSON_PATH=/app/results/web/dashboard.json

# Runtime-only: collection remains off until governance and deployment approval.
LIWAN_ENABLED=false
LIWAN_ENTITY_ID=risklive
LIWAN_PAGEVIEWS=true
LIWAN_ARTICLES=true
LIWAN_FEATURES=true
# All automated tests, including production builds, must disable collection.
ANALYTICS_TEST_MODE=false
