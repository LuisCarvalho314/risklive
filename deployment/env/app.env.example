# Scheduler and ops logs use Europe/London; cron times follow DST.
TZ=Europe/London
HOST=0.0.0.0
PORT=5001
# Legacy host/server only; container roles are selected by their entrypoints.
DISABLE_SCHEDULER=false
LOG_LEVEL=INFO

# Required secrets
VALYU_API_KEY=replace_me
OPENAI_API_KEY=replace_me
OPENAI_API_BASE=https://replace-me.openai.azure.com/
OPENAI_API_VERSION=2024-12-01-preview
OPENAI_API_TYPE=azure

# Packaged container CLI; source checkouts may leave this unset.
RISKLIVE_SECA_CLI=/usr/local/bin/realtime-seca-cli
